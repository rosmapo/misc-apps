def detect_matugen_active(kvantum_config=None):
    """True, ak je v kvantum.kvconfig nastavené theme=matugen."""

    path = Path(kvantum_config or KVANTUM_CONFIG).expanduser()

    try:
        for line in path.read_text(
            encoding="utf-8", errors="replace"
        ).splitlines():
            m = re.match(r"\s*theme\s*=\s*(.*)$", line, re.I)
            if m:
                return m.group(1).strip().lower() == "matugen"
    except OSError:
        pass

    return False


def read_current_wallpaper():
    """Cesta k naposledy nastavenému pozadiu z cache, alebo None."""

    try:
        value = Path(CURRENT_FILE).expanduser().read_text(
            encoding="utf-8"
        ).strip()
    except OSError:
        return None

    return Path(value).expanduser() if value else None


def write_current_wallpaper(img_path):
    """Zapamätá aktuálne pozadie (atómicky: dočasný súbor + premenovanie)."""

    path = Path(CURRENT_FILE).expanduser()
    tmp = path.with_name(path.name + ".tmp")

    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp.write_text(str(img_path), encoding="utf-8")
        os.replace(tmp, path)
    except OSError:
        pass


APPLIED_THEME_FILE = f"{CACHE_DIR}/applied-theme"


def read_applied_theme():
    """Názov (stem) naposledy nastavenej témy, alebo None."""

    try:
        value = Path(APPLIED_THEME_FILE).expanduser().read_text(
            encoding="utf-8"
        ).strip()
    except OSError:
        return None

    return value or None


def write_applied_theme(stem):
    """Zapamätá nastavenú tému; None = žiadna (napr. farby z obrázka)."""

    path = Path(APPLIED_THEME_FILE).expanduser()

    try:
        if stem is None:
            path.unlink(missing_ok=True)
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(stem, encoding="utf-8")
    except OSError:
        pass


def find_matugen_exe():
    return MATUGEN if Path(MATUGEN).exists() else shutil.which("matugen")


def list_wallpapers(wallpaper_dir):
    return sorted(
        f
        for f in Path(wallpaper_dir).expanduser().iterdir()
        if f.suffix.lower() in EXTENSIONS
    )


def apply_wallpaper(img_path):
    """Reštart swaybg s novým obrázkom + zapamätanie (bez Matugenu)."""

    subprocess.run(["pkill", "swaybg"], check=False)

    subprocess.Popen(
        ["swaybg", "-i", str(img_path), "-m", "fill"],
        start_new_session=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    write_current_wallpaper(img_path)


