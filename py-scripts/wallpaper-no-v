    def load_themes(self):
        """Načíta *.json súbory z ~/.config/matugen/themes."""

        self.theme_files.clear()

        if not self.theme_dir.exists():
            self.theme_model.append("Žiadne témy")
            self.theme_dropdown_sensitive = False
            return

        files = sorted(
            self.theme_dir.glob("*.json"),
            key=lambda p: p.stem.lower()
        )

        for path in files:
            self.theme_files.append(path)

            # napr. catppuccin-mocha -> Catppuccin Mocha
            name = path.stem.replace("-", " ")
            name = name.replace("_", " ")
            name = name.title()

            self.theme_model.append(name)

    def refresh_checks(self):
        """Zobrazí kvačku len pri nastavenej téme."""

        for list_item, check in self._check_rows:
            shown = (
                self.applied_theme_index is not None
                and list_item.get_position() == self.applied_theme_index
            )
            check.set_opacity(1.0 if shown else 0.0)

    def mark_applied(self, index):
        """Zapamätá nastavenú tému (index alebo None) a obnoví kvačky."""

        self.applied_theme_index = index

        if index is None:
            write_applied_theme(None)
        else:
            write_applied_theme(self.theme_files[index].stem)

        self.refresh_checks()

    def set_selected_theme(self, *_args):
        """Aplikuje vybranú Matugen JSON tému."""

        if self.busy or not self.matugen_active or not self.theme_files:
            return

        index = self.theme_dropdown.get_selected()

        if index < 0 or index >= len(self.theme_files):
            return

        theme_path = self.theme_files[index]

        print(f"Nastavujem tému: {theme_path}")

        self.run_matugen(
            ["json", str(theme_path)],
            f"Téma nastavená: {self.theme_model.get_string(index)}",
            on_success=lambda: self.mark_applied(index)
        )

    # ================================================================
    # SPÚŠŤANIE MATUGENU (s čakaním na dokončenie)
    # ================================================================

    @staticmethod
    def find_matugen():
        return find_matugen_exe()

    def run_matugen(self, args, done_message, on_success=None):
        """Spustí matugen na pozadí; do dokončenia je UI zablokované."""

        exe = self.find_matugen()

        if not exe:
            self.toast("Matugen nebol nájdený", 6)
            return

        self.busy = True
        self.refresh_mode()

        threading.Thread(
            target=self._matugen_worker,
            args=(exe, args, done_message, on_success),
            daemon=True
        ).start()

    def _matugen_worker(self, exe, args, done_message, on_success):
        errors = []

        try:
            # stderr do súboru: nezablokuje sa na procesoch,
            # ktoré zdedia deskriptor
            with tempfile.TemporaryFile("w+") as err:
                r = subprocess.run(
                    [exe, *args],
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=err,
                    start_new_session=True,
                    timeout=120,
                )
                err.seek(0)
                text = err.read().strip()

            if r.returncode != 0:
                errors.append(f"matugen zlyhal: {text[:120]}")

        except (OSError, subprocess.TimeoutExpired) as e:
            errors.append(f"matugen: {e}")

        GLib.idle_add(self._matugen_done, done_message, errors, on_success)

    def _matugen_done(self, done_message, errors, on_success=None):
        self.busy = False
        self.matugen_active = self.detect_matugen()
        self.refresh_mode()

        for e in errors:
            print(f"Chyba: {e}", file=sys.stderr)

        if errors:
            self.toast(errors[0], 8)
        else:
            if on_success:
                on_success()

            self.toast(done_message)

        return GLib.SOURCE_REMOVE

