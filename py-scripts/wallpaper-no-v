    def detect_matugen(self):
        """True, ak je v kvantum.kvconfig nastavené theme=matugen."""

        return detect_matugen_active(self.kvantum_config)

    def refresh_mode(self):
        """Nastaví aktívnosť ovládacích prvkov podľa aktuálneho režimu."""

        active = self.matugen_active
        idle = not self.busy
        has_themes = len(self.theme_files) > 0

        self.btn_matugen.set_sensitive(idle and not active)
        self.btn_system.set_sensitive(idle and active)

        self.btn_random.set_sensitive(bool(self.images) and idle)

        self.theme_dropdown.set_sensitive(active and has_themes and idle)
        has_selection = (
            self.theme_dropdown.get_selected() < len(self.theme_files)
        )

        self.theme_button.set_sensitive(
            active and has_themes and idle and has_selection
        )

        self.spinner.set_visible(self.busy)
        self.spinner.set_spinning(self.busy)

        if active:
            hint = (
                "Matugen je aktívny\n"
                "Ľavý klik: pozadie + farby · Pravý klik: iba pozadie"
            )
        else:
            hint = "Systémová téma je aktívna\nKlik: iba pozadie"

        self.mode_box.set_tooltip_text(hint)

    def read_matmm(self):
        """Vráti (zoznam súborov, zoznam hookov) zo súboru matmm."""

        files, hooks = [], []

        text = self.matmm_list.read_text(encoding="utf-8")

        for raw in text.splitlines():
            line = raw.strip()

            if not line or line.startswith("#"):
                continue

            m = re.match(r"post_hook\s*=\s*([\'\"])(.*)\1\s*$", line)

            if m:
                hooks.append(m.group(2))
            else:
                files.append(line)

        return files, hooks

    @staticmethod
    def needs_root(path: Path) -> bool:
        """Súbory mimo domovského adresára sa kopírujú cez sudo."""

        try:
            path.relative_to(Path.home())
            return False
        except ValueError:
            return True

    def on_switch_clicked(self, ext):
        """Spustí prepnutie (ext = matugen | mirosma)."""

        self.busy = True
        self.refresh_mode()

        threading.Thread(
            target=self._switch_worker,
            args=(ext,),
            daemon=True
        ).start()

    @staticmethod
    def backup_candidates(dst: Path, ext: str):
        """Záloha = celý názov + prípona: gtk.css -> gtk.css.matugen."""

        return [dst.with_name(f"{dst.name}.{ext}")]

    # Skript pre pkexec: argumenty sú trojice  CIEĽ ZÁLOHA1 ZÁLOHA2.
    # Prepíše iba OBSAH cieľového súboru (cp bez --remove-destination).
    ROOT_COPY_SCRIPT = (
        'rc=0; '
        'while [ "$#" -ge 3 ]; do '
        '  if [ -f "$2" ]; then src="$2"; '
        '  elif [ -f "$3" ]; then src="$3"; '
        '  else echo "chýba záloha: $2" >&2; rc=1; shift 3; continue; fi; '
        '  cp -f -- "$src" "$1" || rc=1; '
        '  shift 3; '
        'done; exit $rc'
    )

    def _switch_worker(self, ext):
        """Beží na pozadí: prepíše obsah súborov a spustí hooky."""

        label = "Matugen" if ext == "matugen" else "Systém"
        errors = []

        try:
            files, hooks = self.read_matmm()
        except OSError as e:
            GLib.idle_add(
                self._switch_done,
                label,
                [f"Nepodarilo sa načítať {self.matmm_list}: {e}"],
                True
            )
            return

        targets = [Path(f).expanduser() for f in files]

        root_targets = [t for t in targets if self.needs_root(t)]
        user_targets = [t for t in targets if not self.needs_root(t)]

        # 1) Súbory vyžadujúce root: jedno pkexec (jedno okno na heslo).
        #    Robí sa ako prvé, aby zrušenie neprepísalo nič.
        if root_targets:
            args = []

            for dst in root_targets:
                cands = self.backup_candidates(dst, ext)
                args += [str(dst), str(cands[0]), str(cands[-1])]

            try:
                r = subprocess.run(
                    ["pkexec", "/bin/sh", "-c",
                     self.ROOT_COPY_SCRIPT, "sh", *args],
                    stdin=subprocess.DEVNULL,
                    capture_output=True,
                    text=True,
                )
            except OSError as e:
                GLib.idle_add(
                    self._switch_done,
                    label,
                    [f"pkexec sa nepodarilo spustiť: {e}"],
                    True
                )
                return

            if r.returncode == 126:
                GLib.idle_add(
                    self._switch_done,
                    label,
                    ["Overenie zrušené alebo zamietnuté"],
                    True
                )
                return

            if r.returncode == 127:
                GLib.idle_add(
                    self._switch_done,
                    label,
                    ["Nie je spustený polkit agent (pkexec)"],
                    True
                )
                return

            if r.returncode != 0:
                errors.append(
                    f"root súbory: {r.stderr.strip() or 'cp zlyhalo'}"
                )

        # 2) Používateľské súbory
        for dst in user_targets:
            src = next(
                (c for c in self.backup_candidates(dst, ext)
                 if c.is_file()),
                None
            )

            if src is None:
                errors.append(f"{dst.name}: chýba záloha .{ext}")
                continue

            try:
                shutil.copyfile(src, dst)
            except OSError as e:
                errors.append(f"{dst}: {e}")

        # 3) Hooky (ako bežný používateľ, aby fungovali gsettings a pod.)
        for hook in hooks:
            try:
                with tempfile.TemporaryFile("w+") as err:
                    r = subprocess.run(
                        ["bash", "-c", hook],
                        stdin=subprocess.DEVNULL,
                        stdout=subprocess.DEVNULL,
                        stderr=err,
                        timeout=60,
                    )
                    err.seek(0)
                    err_text = err.read().strip()

                if r.returncode != 0:
                    errors.append(
                        f"hook zlyhal: {hook[:50]} "
                        f"({err_text[:80]})"
                    )

            except (OSError, subprocess.TimeoutExpired) as e:
                errors.append(f"hook: {hook[:50]}: {e}")

        GLib.idle_add(self._switch_done, label, errors, False)

    def _switch_done(self, label, errors, aborted):
        """Beží v hlavnom vlákne: obnoví stav a ukáže výsledok."""

        self.busy = False
        self.matugen_active = self.detect_matugen()

        if not aborted:
            self.mark_applied(None)

        self.refresh_mode()

        for e in errors:
            print(f"Chyba: {e}", file=sys.stderr)

        if aborted:
            self.toast(errors[0], 6)
        elif errors:
            self.show_errors_dialog(label, errors)
        else:
            self.toast(f"Prepnuté na: {label}")

        return GLib.SOURCE_REMOVE

    def show_errors_dialog(self, label, errors):
        """Zobrazí všetky chyby z prepnutia (text sa dá označiť a skopírovať)."""

        count = len(errors)

        if count == 1:
            word = "chybou"
        else:
            word = f"{count} chybami"

        dialog = Adw.AlertDialog(
            heading=f"Prepnuté na {label} s {word}",
            body="Ostatné súbory a hooky sa spracovali.",
        )

        text = Gtk.Label(
            label="\n\n".join(errors),
            selectable=True,
            wrap=True,
            xalign=0,
            halign=Gtk.Align.START,
        )
        text.add_css_class("monospace")

        scrolled = Gtk.ScrolledWindow(
            hscrollbar_policy=Gtk.PolicyType.NEVER,
            propagate_natural_height=True,
            min_content_height=60,
            max_content_height=300,
            child=text,
        )

        dialog.set_extra_child(scrolled)
        dialog.add_response("close", "Zavrieť")
        dialog.set_default_response("close")
        dialog.set_close_response("close")

        dialog.present(self)

    # ================================================================
    # CACHE
    # ================================================================

    def get_cache_path(self, img_path: Path) -> Path:
        """Unikátny názov cache na základe cesty a času modifikácie."""

        key = f"{img_path}_{img_path.stat().st_mtime}"

        return (
            self.cache_dir
            / f"{hashlib.md5(key.encode()).hexdigest()}.jpg"
        )

    # ================================================================
    # NAČÍTANIE
    # ================================================================

    def show_status(
        self,
        title,
        icon="image-missing-symbolic"
    ):
        self.status.set_title(title)
        self.status.set_icon_name(icon)
        self.stack.set_visible_child_name("status")

    def load_wallpapers(self):

        if not self.wallpaper_dir.exists():
            self.show_status(
                f"Adresár {self.wallpaper_dir} neexistuje!",
                "dialog-error-symbolic"
            )
            return

        images = list_wallpapers(self.wallpaper_dir)

        if not images:
            self.show_status(
                "Žiadne obrázky nenájdené!"
            )
            return

        self.images = images
        self.refresh_mode()

        threading.Thread(
            target=self._process_images,
            args=(images,),
            daemon=True
        ).start()

    def _process_images(self, images):
        """Beží na pozadí: generuje a ukladá náhľady do cache."""

        for img_path in images:

            cache_path = self.get_cache_path(img_path)

            if not cache_path.exists():

                try:
                    with Image.open(img_path) as img:

                        img = img.convert("RGB")

                        img.thumbnail(
                            (250, 150),
                            Image.Resampling.BILINEAR
                        )

                        img.save(
                            cache_path,
                            "JPEG",
                            quality=85
                        )

                except Exception as e:
                    print(
                        f"Chyba pri spracovaní "
                        f"{img_path.name}: {e}"
                    )
                    continue

            GLib.idle_add(
                self._add_thumbnail,
                img_path,
                cache_path
            )

    def _add_thumbnail(
        self,
        img_path,
        cache_path
    ):
        """Beží v hlavnom vlákne: vytvorí widget z cache."""

        try:
            texture = Gdk.Texture.new_from_filename(
                str(cache_path)
            )

        except GLib.Error as e:

            print(
                f"Chyba náhľadu "
                f"{img_path.name}: {e.message}"
            )

            return GLib.SOURCE_REMOVE

        picture = Gtk.Picture(
            paintable=texture,
            content_fit=Gtk.ContentFit.COVER,
            can_shrink=True,
        )

        picture.set_size_request(
            250,
            150
        )

        picture.set_overflow(
            Gtk.Overflow.HIDDEN
        )

        picture.add_css_class(
            "wp-thumb"
        )

        picture.add_css_class(
            "card"
        )

        picture.set_cursor(
            Gdk.Cursor.new_from_name("pointer")
        )

        picture.set_tooltip_text(
            img_path.name
        )

        # ------------------------------------------------------------
        # Ľavý klik
        # wallpaper + Matugen
        # ------------------------------------------------------------

        left = Gtk.GestureClick(
            button=Gdk.BUTTON_PRIMARY
        )

        left.connect(
            "released",
            lambda *_a, p=img_path:
                self.set_wallpaper(p, self.matugen_active)
        )

        picture.add_controller(left)

        # ------------------------------------------------------------
        # Pravý klik
        # iba wallpaper
        # ------------------------------------------------------------

        right = Gtk.GestureClick(
            button=Gdk.BUTTON_SECONDARY
        )

        right.connect(
            "released",
            lambda *_a, p=img_path:
                self.set_wallpaper(p, False)
        )

        picture.add_controller(right)

        self.flowbox.append(
            picture
        )

        return GLib.SOURCE_REMOVE

    # ================================================================
    # NASTAVENIE WALLPAPERU
    # ================================================================

    def set_wallpaper(
        self,
        img_path: Path,
        run_matugen=True
    ):
        """
        Ľavý klik:
            wallpaper + Matugen

        Pravý klik:
            iba wallpaper

        Rýchle kroky prebehnú hneď,
        Matugen beží na pozadí; do dokončenia je UI zablokované.
        Okno ostáva otvorené.
        """

        if run_matugen and self.busy:
            self.toast("Počkaj, kým dobehne prebiehajúca zmena…")
            return

        try:

            apply_wallpaper(img_path)

            self.current_wallpaper = img_path

        except Exception as e:

            print(
                f"Chyba pri nastavovaní pozadia: {e}"
            )

            self.toast(f"Chyba pri nastavovaní pozadia: {e}", 6)

            return

        if run_matugen:
            self.run_matugen(
                [
                    "image",
                    str(img_path),
                    "--prefer",
                    "darkness"
                ],
                "Pozadie a farby nastavené",
                on_success=lambda: self.mark_applied(None)
            )
        else:
            self.toast("Pozadie nastavené")



class WallpaperApp(Adw.Application):

    def __init__(self):

        super().__init__(
            application_id="sk.mm.WallpaperChooser",
            flags=Gio.ApplicationFlags.FLAGS_NONE
        )

    def do_startup(self):

        Adw.Application.do_startup(
            self
        )

        # Vynútený tmavý režim libadwaita
        Adw.StyleManager.get_default().set_color_scheme(
            Adw.ColorScheme.FORCE_DARK
        )

        provider = Gtk.CssProvider()

        provider.load_from_data(
            CSS
        )

        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def do_activate(self):

        win = (
            self.props.active_window
            or WallpaperWindow(
                self,
                WALLPAPER_DIR
            )
        )

        win.present()


