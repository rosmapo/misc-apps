def notify_error(message):
    """Urgentná systémová notifikácia (ak je k dispozícii notify-send)."""

    exe = shutil.which("notify-send")

    if not exe:
        return

    try:
        subprocess.run(
            [
                exe,
                "-u", "critical",
                "-a", "wallpaper",
                "-i", "dialog-error",
                "Pozadie: chyba",
                message,
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def cli_fail(message):
    """Vypíše chybu na stderr, ukáže notifikáciu a vráti kód 1."""

    print(message, file=sys.stderr)
    notify_error(message)

    return 1


def acquire_lock():
    """Zámok: opakované spustenie nespustí dve zmeny pozadia naraz."""

    runtime = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    lock = open(Path(runtime) / "wallpaper-cli.lock", "w")

    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("Iná zmena pozadia ešte beží.", file=sys.stderr)
        return None

    return lock


def cli_random():
    """Náhodné pozadie bez GUI. Vracia návratový kód procesu."""

    lock = acquire_lock()

    if lock is None:
        return 0

    return random_locked()


def cli_permanent():
    """Obnoví naposledy nastavené pozadie; ak chýba, vyberie náhodné."""

    lock = acquire_lock()

    if lock is None:
        return 0

    current = read_current_wallpaper()

    if current is not None and current.is_file():
        try:
            apply_wallpaper(current)
        except Exception as e:
            return cli_fail(f"Chyba pri nastavovaní pozadia: {e}")

        print(f"Pozadie: {current}")
        return 0

    # Fallback: cache sa vymazala alebo obrázok už neexistuje
    print("Uložené pozadie chýba, vyberám náhodné.", file=sys.stderr)

    return random_locked()


def random_locked():
    """Vyberie a nastaví náhodné pozadie (zámok už drží volajúci)."""

    wallpaper_dir = Path(WALLPAPER_DIR).expanduser()

    try:
        images = list_wallpapers(wallpaper_dir)
    except OSError as e:
        return cli_fail(f"Adresár {wallpaper_dir}: {e}")

    if not images:
        return cli_fail(f"Žiadne obrázky v {wallpaper_dir}.")

    current = read_current_wallpaper()
    pool = [p for p in images if p != current] or images
    img = random.choice(pool)

    use_matugen = detect_matugen_active()

    try:
        apply_wallpaper(img)
    except Exception as e:
        return cli_fail(f"Chyba pri nastavovaní pozadia: {e}")

    print(f"Pozadie: {img}")

    if not use_matugen:
        return 0

    exe = find_matugen_exe()

    if not exe:
        return cli_fail("Pozadie je nastavené, ale matugen nebol nájdený.")

    try:
        r = subprocess.run(
            [exe, "image", str(img), "--prefer", "darkness"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            timeout=120,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        return cli_fail(f"Pozadie je nastavené, ale matugen zlyhal: {e}")

    if r.returncode != 0:
        return cli_fail(
            "Pozadie je nastavené, ale matugen zlyhal: "
            f"{r.stderr.strip()[:200]}"
        )

    write_applied_theme(None)

    return 0


