def save_config(config):
    with open(CONFIG_FILE, 'w') as f:
        config.write(f)

def create_default_config():
    CONFIG_DIR.mkdir(exist_ok=True)
    config = configparser.ConfigParser()
    for section, options in DEFAULT_CONFIG.items():
        config[section] = options
    save_config(config)
    print(f"Vytvorený predvolený config: {CONFIG_FILE}")

def load_config():
    if not CONFIG_FILE.exists():
        create_default_config()
    config = configparser.ConfigParser()
    config.read(CONFIG_FILE)
    changed = False
    for section, options in DEFAULT_CONFIG.items():
        if section not in config:
            config[section] = {}
            changed = True
        for key, value in options.items():
            if key not in config[section]:
                config[section][key] = value
                changed = True
        for key in list(config[section].keys()):
            if key not in options:
                del config[section][key]
                changed = True
    for section in list(config.sections()):
        if section not in DEFAULT_CONFIG:
            config.remove_section(section)
            changed = True
    if changed:
        save_config(config)
    return config

def get_cache_path(file_path, thumb_size=None, bg_color=None):
    key = str(Path(file_path).absolute())
    if thumb_size is not None:
        key += f"@{int(thumb_size)}"
    path_hash = hashlib.md5(key.encode()).hexdigest()
    return CACHE_DIR / f"{path_hash}.png"

def hex_to_pixbuf_rgba(hex_color, alpha=0xff):
    h = (hex_color or '#1a1a1a').strip().lstrip('#')
    if len(h) >= 8:
        r, g, b, a = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16), int(h[6:8], 16)
    elif len(h) >= 6:
        r, g, b, a = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16), alpha
    else:
        r, g, b, a = 0x1a, 0x1a, 0x1a, alpha
    return (r << 24) | (g << 16) | (b << 8) | a

def fit_pixbuf_contain(pixbuf, size):
    w, h = pixbuf.get_width(), pixbuf.get_height()
    if w <= 0 or h <= 0:
        return pixbuf
    if w <= size and h <= size and (w == size or h == size):
        if w == size or h == size:
            return pixbuf
    scale = min(size / w, size / h)
    nw = max(1, int(round(w * scale)))
    nh = max(1, int(round(h * scale)))
    if nw == w and nh == h:
        return pixbuf
    return pixbuf.scale_simple(nw, nh, GdkPixbuf.InterpType.BILINEAR)

def resolve_initial_folder(arg):
    if not arg:
        return None
    try:
        if arg.startswith('file://'):
            arg = urllib.parse.unquote(urllib.parse.urlparse(arg).path)
        p = Path(arg).expanduser().resolve()
        if p.is_dir():
            return p
        if p.is_file():
            return p.parent
    except Exception as e:
        print(f"Nepodarilo sa spracovať argument priečinka '{arg}': {e}")
    return None

