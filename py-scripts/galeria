    def show_toast(self, message, duration=2):
        if not self.show_notifications:
            return
        self.toast_overlay.add_toast(Adw.Toast(title=message, timeout=duration))

    def _apply_css(self):
        css_provider = Gtk.CssProvider()
        css_provider.load_from_data(f"""
            window {{
                background-color: {self.bg_color};
            }}
            scrollbar {{
                opacity: 0;
                min-width: 0;
                min-height: 0;
                margin: 0;
                padding: 0;
            }}
            scrollbar slider {{
                min-width: 0;
                min-height: 0;
            }}
            scrolledwindow {{
                background: transparent;
            }}
            flowboxchild,
            flowboxchild:focus,
            flowboxchild:focus-visible,
            flowboxchild:selected {{
                outline: none;
                box-shadow: none;
                border: none;
            }}
        """.encode())
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        if hasattr(self, 'scrolled') and self.scrolled is not None:
            self.scrolled.set_overlay_scrolling(True)

    def on_window_realize(self, widget):
        self._recalc_attempts = 0
        GLib.idle_add(self._lock_layout_width)
        GLib.timeout_add(50, self._lock_layout_width)
        GLib.timeout_add(200, self.recalculate_if_needed)

    def _viewport_width(self):
        try:
            return max(200, int(self.config.get('Appearance', 'window_width', fallback='1920')))
        except (TypeError, ValueError):
            return 1920

    def _lock_layout_width(self):
        self._fixed_layout_width = self._viewport_width()
        return False

    def _compute_thumb_size(self, width=None):
        if width is None or width <= 1:
            width = self._viewport_width()
        cols = max(1, self.columns)
        usable = width - 2 * GRID_MARGIN - (cols - 1) * GRID_SPACING
        return max(16, usable // cols)

    def _apply_grid_geometry(self):
        cols = max(1, self.columns)
        width = self._viewport_width()
        self.spacing = GRID_SPACING
        self.thumb_size = self._compute_thumb_size(width)
        row_w = cols * self.thumb_size + (cols - 1) * GRID_SPACING
        leftover = max(0, width - row_w - 2 * GRID_MARGIN)
        self.margin_left = GRID_MARGIN + leftover // 2
        self.margin_right = GRID_MARGIN + leftover - leftover // 2
        self.margin = self.margin_left

        self.grid_box.set_spacing(GRID_SPACING)
        self.grid_box.set_size_request(row_w, -1)
        self.grid_box.set_hexpand(False)
        self.grid_box.set_halign(Gtk.Align.START)
        if hasattr(self, 'grid_wrap') and self.grid_wrap is not None:
            self.grid_wrap.set_margin_start(self.margin_left)
            self.grid_wrap.set_margin_end(self.margin_right)
            self.grid_wrap.set_margin_top(GRID_MARGIN)
            self.grid_wrap.set_margin_bottom(GRID_MARGIN)
            self.grid_wrap.set_size_request(row_w, -1)

    def recalculate_if_needed(self):
        self._lock_layout_width()
        new_ts = self._compute_thumb_size()
        if abs(new_ts - self.thumb_size) >= 1:
            self._apply_grid_geometry()
            self.load_folder(self.current_folder)
        return False

    def _make_tooltip(self, path):
        try:
            stat = path.stat()
            size = format_size(stat.st_size)
            mtime = time.strftime("%d.%m.%Y %H:%M", time.localtime(stat.st_mtime))
            res = ""
            if path.suffix.lower() in IMAGE_EXTS:
                try:
                    info = GdkPixbuf.Pixbuf.get_file_info(str(path))
                    if info and info[1] > 0:
                        res = f"\n{info[1]} × {info[2]}"
                except Exception:
                    pass
            return f"{path.name}\n{size}  •  {mtime}{res}"
        except Exception:
            return path.name

    def load_folder(self, folder):
        if not folder.exists():
            print(f"Adresár neexistuje: {folder}")
            return
        self.current_folder = folder
        child = self.grid_box.get_first_child()
        while child is not None:
            self.grid_box.remove(child)
            child = self.grid_box.get_first_child()
        self.widget_map.clear()
        self.file_widgets.clear()
        self.thumb_queue = queue.Queue()

        all_files = [f for f in folder.iterdir() if f.suffix.lower() in IMAGE_EXTS + VIDEO_EXTS]

        sort_by = self.config.get('Sorting', 'sort_by', fallback='date').strip().lower()
        sort_order = self.config.get('Sorting', 'sort_order', fallback='descending').strip().lower()
        reverse = (sort_order == 'descending')

        if sort_by == 'name':
            all_files.sort(key=lambda f: f.name.lower(), reverse=reverse)
        else:
            all_files.sort(key=lambda f: f.stat().st_mtime, reverse=reverse)

        self.all_files = all_files
        self.load_thumbnails(all_files)
        self.set_title(f"Galéria – {folder}")

    def load_thumbnails(self, files):
        ts = self.thumb_size
        cols = max(1, self.columns)
        row_w = cols * ts + (cols - 1) * GRID_SPACING
        self.grid_box.set_size_request(row_w, -1)

        visible = []
        for f in files:
            ft = 'image' if f.suffix.lower() in IMAGE_EXTS else 'video'
            if self.current_filter == 'images' and ft != 'image':
                continue
            if self.current_filter == 'videos' and ft != 'video':
                continue
            visible.append((f, ft))

        self._load_gen += 1
        self._cur_row = None
        self._col = 0
        placeholder = Gdk.Texture.new_for_pixbuf(self.create_placeholder())
        self._build_chunk(visible, 0, self._load_gen, ts, cols, row_w, placeholder)

    def _build_chunk(self, visible, start, gen, ts, cols, row_w, placeholder):
        if gen != self._load_gen:
            return False
        end = min(start + CHUNK, len(visible))
        for f, ft in visible[start:end]:
            self._add_cell(f, ft, ts, cols, row_w, placeholder)
            self._executor.submit(self._thumb_task, f, gen, ts)
        if end < len(visible):
            GLib.idle_add(self._build_chunk, visible, end, gen, ts, cols, row_w, placeholder)
        return False

    def _add_cell(self, f, file_type, ts, cols, row_w, placeholder):
        image = Gtk.Image.new_from_paintable(placeholder)
        image.set_size_request(ts, ts)
        try:
            image.set_pixel_size(ts)
        except Exception:
            pass
        image.set_halign(Gtk.Align.CENTER)
        image.set_valign(Gtk.Align.CENTER)
        image.set_hexpand(True)
        image.set_vexpand(True)

        box = Gtk.Box()
        box.set_size_request(ts, ts)
        box.set_hexpand(False)
        box.set_vexpand(False)
        box.set_halign(Gtk.Align.CENTER)
        box.set_valign(Gtk.Align.CENTER)
        try:
            box.set_overflow(Gtk.Overflow.HIDDEN)
        except Exception:
            pass
        box.append(image)

        if self.show_tooltips:  # tooltip sa vytvorí až pri hoveri
            box.set_has_tooltip(True)
            box.connect("query-tooltip", self._on_query_tooltip, f)

        left_click = Gtk.GestureClick.new()
        left_click.set_button(1)
        left_click.connect("pressed", self.on_left_click, f, file_type)
        box.add_controller(left_click)

        right_click = Gtk.GestureClick.new()
        right_click.set_button(3)
        right_click.connect("pressed", self.on_right_click, f, file_type)
        box.add_controller(right_click)

        middle_click = Gtk.GestureClick.new()
        middle_click.set_button(2)
        middle_click.connect("pressed", self.on_middle_click, f)
        box.add_controller(middle_click)

        if self._cur_row is None or self._col >= cols:
            self._cur_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=GRID_SPACING)
            self._cur_row.set_halign(Gtk.Align.START)
            self._cur_row.set_hexpand(False)
            self._cur_row.set_size_request(row_w, ts)
            self.grid_box.append(self._cur_row)
            self._col = 0

        self._cur_row.append(box)
        self._col += 1

        self.widget_map[f] = image
        self.file_widgets[f] = (box, file_type)

    def _on_query_tooltip(self, widget, x, y, keyboard, tooltip, f):
        tooltip.set_text(self._make_tooltip(f))
        return True

    def create_placeholder(self):
        pixbuf = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, False, 8,
                                      self.thumb_size, self.thumb_size)
        color = (50, 50, 50)
        pixbuf.fill((color[0]<<24) | (color[1]<<16) | (color[2]<<8) | 0xff)
        return pixbuf

    def _thumb_task(self, f, gen, ts):
        """Beží vo worker vlákne: načíta miniatúru z cache alebo ju vygeneruje."""
        if gen != self._load_gen:
            return
        cache_file = get_cache_path(f, ts, self.bg_color)
        pixbuf = None
        try:
            if cache_file.exists() and cache_file.stat().st_size > 0:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file(str(cache_file))
        except Exception as e:
            print(f"Chyba pri načítaní cache {cache_file}: {e}")
            try:
                cache_file.unlink(missing_ok=True)
            except Exception:
                pass
        if pixbuf is None:
            pixbuf = self.generate_thumbnail(f)
        if pixbuf is None or gen != self._load_gen:
            return
        texture = Gdk.Texture.new_for_pixbuf(fit_pixbuf_contain(pixbuf, ts))
        GLib.idle_add(self._set_thumb, f, texture, gen)

    def _set_thumb(self, f, texture, gen):
        if gen == self._load_gen:
            img = self.widget_map.get(f)
            if img is not None:
                img.set_from_paintable(texture)
        return False

    def generate_thumbnail(self, path):
        cache_file = get_cache_path(path, self.thumb_size, self.bg_color)
        try:
            if path.suffix.lower() in VIDEO_EXTS:
                subprocess.run([
                    "ffmpegthumbnailer",
                    "-i", str(path),
                    "-o", str(cache_file),
                    "-s", str(self.thumb_size),
                    "-q", "10",
                    "-f"
                ], check=True, capture_output=True)
            elif HAVE_PIL:
                with Image.open(path) as im:
                    im.draft('RGB', (self.thumb_size, self.thumb_size))  # JPEG: dekóduje rovno zmenšené
                    im = ImageOps.exif_transpose(im)
                    im.thumbnail((self.thumb_size, self.thumb_size), Image.LANCZOS)
                    if im.mode not in ("RGB", "RGBA"):
                        im = im.convert("RGB")
                    tmp = cache_file.with_suffix(".tmp.png")
                    im.save(tmp, "PNG", compress_level=1)
                    tmp.replace(cache_file)
            else:
                subprocess.run([
                    "convert",
                    str(path),
                    "-auto-orient",
                    "-thumbnail", f"{self.thumb_size}x{self.thumb_size}",
                    str(cache_file)
                ], check=True, capture_output=True)
            pb = GdkPixbuf.Pixbuf.new_from_file(str(cache_file))
            return fit_pixbuf_contain(pb, self.thumb_size)
        except Exception as e:
            print(f"Chyba pri generovaní thumbnailu pre {path}: {e}")
            return None

    def apply_filter(self, filter_type):
        self.current_filter = filter_type
        self.load_folder(self.current_folder)

    def open_folder_dialog(self):
        dialog = Gtk.FileDialog.new()
        dialog.set_title("Vyber adresár")
        dialog.set_modal(True)
        dialog.select_folder(None, None, self.on_folder_selected)

    def on_folder_selected(self, dialog, result):
        try:
            folder = dialog.select_folder_finish(result)
            if folder:
                folder_path = Path(folder.get_path())
                self.load_folder(folder_path)
        except Exception as e:
            print(f"Chyba pri výbere adresára: {e}")

    def execute_command(self, cmd_num):
        cmd_key = f'cmd{cmd_num}'
        if cmd_key in self.config['Commands']:
            cmd = self.config['Commands'][cmd_key]
            if cmd:
                cmd = cmd.replace('{folder}', str(self.current_folder))
                cmd = os.path.expandvars(cmd)
                subprocess.Popen(cmd, shell=True)

    def open_file(self, path):
        ext = path.suffix.lower()
        if ext in IMAGE_EXTS:
            opener = self.image_opener
        elif ext in VIDEO_EXTS:
            opener = self.video_opener
        else:
            return
        if opener == 'default':
            subprocess.Popen(["xdg-open", str(path)])
        else:
            subprocess.Popen([opener, str(path)])

    def edit_file(self, path, file_type):
        if file_type == 'image':
            editor = self.image_editor
        elif file_type == 'video':
            editor = self.video_editor
        else:
            return
        try:
            subprocess.Popen([editor, str(path)])
        except Exception as e:
            print(f"Chyba pri spustení editora {editor}: {e}")

    def trim_video(self, path):
        try:
            subprocess.Popen([self.video_trimmer, str(path)])
        except Exception as e:
            print(f"Chyba pri spustení strihača {self.video_trimmer}: {e}")

    def copy_to_downloads(self, path):
        try:
            destination = self.download_folder / path.name
            counter = 1
            while destination.exists():
                stem = path.stem
                suffix = path.suffix
                destination = self.download_folder / f"{stem}_{counter}{suffix}"
                counter += 1
            shutil.copy2(str(path), str(destination))
            print(f"Skopírované: {path.name} -> {destination}")
            self.show_toast(f"Skopírované: {destination.name}")
        except Exception as e:
            print(f"Chyba pri kopírovaní {path}: {e}")

    def get_crop_ratio_for_image(self, image_path):
        ratio = self.config.get('Crop', 'ratio', fallback='3:2').strip().lower()
        orientation = self.config.get('Crop', 'orientation', fallback='automatic').strip().lower()
        custom = self.config.get('Crop', 'custom_ratio', fallback='3:2').strip()

        if ratio == 'custom':
            base = custom if custom else '3:2'
        else:
            base = ratio

        parsed = parse_ratio(base)
        if parsed is None:
            base = '3:2'
            parsed = (3.0, 2.0)

        w, h = parsed

        try:
            pb = GdkPixbuf.Pixbuf.new_from_file(str(image_path))
            pb = pb.apply_embedded_orientation()
            img_w, img_h = pb.get_width(), pb.get_height()
            is_portrait = img_h > img_w
        except Exception:
            is_portrait = False

        if orientation == 'portrait':
            if w > h:
                return f"{h}:{w}"
            return base
        elif orientation == 'landscape':
            if h > w:
                return f"{h}:{w}"
            return base
        else:
            if is_portrait:
                if w > h:
                    return f"{h}:{w}"
                return base
            else:
                if h > w:
                    return f"{h}:{w}"
                return base

    def on_left_click(self, gesture, n_press, x, y, path, file_type):
        event = gesture.get_current_event()
        state = event.get_modifier_state()
        if state & Gdk.ModifierType.CONTROL_MASK:
            self.edit_file(path, file_type)
        else:
            self.open_file(path)

    def on_right_click(self, gesture, n_press, x, y, path, file_type):
        if file_type == 'image':
            ratio = self.get_crop_ratio_for_image(path)
            CropWindow(self, path, self.download_folder, ratio)
        elif file_type == 'video':
            self.trim_video(path)

    def on_middle_click(self, gesture, n_press, x, y, path):
        self.copy_to_downloads(path)

    def get_actions(self):
        return {
            'quit': lambda: self.close(),
            'open_folder': self.open_folder_dialog,
            'filter_images': lambda: self.apply_filter('images'),
            'filter_videos': lambda: self.apply_filter('videos'),
            'filter_all': lambda: self.apply_filter('all'),
            'command1': lambda: self.execute_command(1),
            'command2': lambda: self.execute_command(2),
            'command3': lambda: self.execute_command(3),
            'settings': self.open_settings_dialog,
        }

    def on_key_press(self, controller, keyval, keycode, state):
        shortcuts = self.config['Shortcuts']
        relevant_mods = (Gdk.ModifierType.CONTROL_MASK |
                        Gdk.ModifierType.ALT_MASK |
                        Gdk.ModifierType.SHIFT_MASK)
        state = state & relevant_mods
        keyval = Gdk.keyval_to_lower(keyval)
        for name, action in self.get_actions().items():
            shortcut_str = shortcuts.get(name)
            if not shortcut_str:
                continue
            key, mod = parse_shortcut(shortcut_str)
            if key and keyval == key and state == mod:
                action()
                return True
        return False

    def open_settings_dialog(self):
        try:
            self.config = load_config()
            dialog = SettingsDialog(self)
            dialog.present()
        except Exception as e:
            print(f"Chyba pri otváraní nastavení: {e}")
            import traceback
            traceback.print_exc()

    def apply_settings_from_dialog(self):
        self.config = load_config()
        self.columns = int(self.config['Appearance']['columns'])
        self.spacing = GRID_SPACING
        self.margin = GRID_MARGIN
        self.bg_color = self.config['Appearance']['background_color']
        self.hide_scrollbar = True
        self.show_tooltips = self.config.getboolean('Appearance', 'show_tooltips', fallback=True)
        self.show_notifications = self.config.getboolean('Appearance', 'show_notifications', fallback=True)
        self.image_opener = self.config['Openers']['image_opener']
        self.video_opener = self.config['Openers']['video_opener']
        self.image_editor = self.config.get('Editors', 'image_editor', fallback='gimp')
        self.video_editor = self.config.get('Editors', 'video_editor', fallback='vlc')
        self.video_trimmer = self.config.get('Editors', 'video_trimmer', fallback='gnome-video-trimmer')
        download_folder = Path(os.path.expandvars(
            self.config.get('Paths', 'download_folder', fallback=str(Path.home() / "Downloads"))
        ))
        self.download_folder = download_folder if download_folder.exists() else Path.home() / "Downloads"
        self.download_folder.mkdir(exist_ok=True)
        self._apply_css()
        self._apply_grid_geometry()
        self.load_folder(self.current_folder)

class ShortcutRecorder(Gtk.Box):
    def __init__(self, initial_value, on_change=None):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.value = initial_value or ''
        self.on_change = on_change
        self.label = Gtk.Label(label=self.value or '(žiadna)')
        self.label.set_xalign(1)
        self.label.add_css_class("dim-label")
        self.record_btn = Gtk.Button(label="Nahrať")
        self.record_btn.add_css_class("flat")
        self.record_btn.connect("clicked", self._start_recording)
        self.append(self.label)
        self.append(self.record_btn)
        self._capture_controller = None

    def get_value(self):
        return self.value

    def _start_recording(self, button):
        if self._capture_controller is not None:
            return
        root = self.get_root()
        if not root:
            return
        self.record_btn.set_label("Stlač klávesu…")
        self.record_btn.set_sensitive(False)

        controller = Gtk.EventControllerKey()
        controller.connect("key-pressed", self._on_key_pressed)
        controller.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        root.add_controller(controller)
        self._capture_controller = controller

    def _stop_recording(self):
        root = self.get_root()
        if root and self._capture_controller:
            root.remove_controller(self._capture_controller)
        self._capture_controller = None
        self.record_btn.set_label("Nahrať")
        self.record_btn.set_sensitive(True)

    def _on_key_pressed(self, controller, keyval, keycode, state):
        if keyval in MODIFIER_KEYVALS:
            return True

        relevant = state & (Gdk.ModifierType.CONTROL_MASK |
                             Gdk.ModifierType.ALT_MASK |
                             Gdk.ModifierType.SHIFT_MASK)
        mods = []
        if relevant & Gdk.ModifierType.CONTROL_MASK:
            mods.append('ctrl')
        if relevant & Gdk.ModifierType.ALT_MASK:
            mods.append('alt')
        if relevant & Gdk.ModifierType.SHIFT_MASK:
            mods.append('shift')

        lowered = Gdk.keyval_to_lower(keyval)
        gdk_name = Gdk.keyval_name(lowered) or ''
        key_str = KEYVAL_DISPLAY_NAMES.get(gdk_name, gdk_name.lower())

        if key_str:
            self.value = '+'.join([key_str] + mods)
            self.label.set_label(self.value)
            if self.on_change:
                self.on_change(self.value)

        self._stop_recording()
        return True

