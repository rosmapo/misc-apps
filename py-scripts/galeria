def resolve_keyval(key):
    key = key.strip()
    if not key:
        return 0
    if len(key) == 1:
        return Gdk.keyval_from_name(key)
    name = KEY_NAME_ALIASES.get(key.lower(), key)
    return Gdk.keyval_from_name(name)

def parse_shortcut(shortcut_str):
    tokens = [t.strip().lower() for t in shortcut_str.split('+') if t.strip()]
    modifiers = [t for t in tokens if t in MOD_NAMES]
    keys = [t for t in tokens if t not in MOD_NAMES]
    keyval = resolve_keyval(keys[0]) if keys else 0
    if keyval:
        keyval = Gdk.keyval_to_lower(keyval)
    modifier_mask = 0
    if 'ctrl' in modifiers:
        modifier_mask |= Gdk.ModifierType.CONTROL_MASK
    if 'alt' in modifiers:
        modifier_mask |= Gdk.ModifierType.ALT_MASK
    if 'shift' in modifiers:
        modifier_mask |= Gdk.ModifierType.SHIFT_MASK
    return keyval, modifier_mask

def validate_shortcuts(config):
    seen = {}
    for name, value in config['Shortcuts'].items():
        keyval, mod = parse_shortcut(value)
        if keyval == 0:
            print(f"[UPOZORNENIE] Skratka '{name}' = '{value}' obsahuje neznámu klávesu.")
            continue
        combo = (keyval, mod)
        if combo in seen:
            print(f"[UPOZORNENIE] Skratky '{seen[combo]}' a '{name}' (hodnota '{value}') "
                  f"používajú rovnakú kombináciu kláves - zareaguje len '{seen[combo]}'.")
        else:
            seen[combo] = name

def rgba_to_hex(rgba):
    r = round(rgba.red * 255)
    g = round(rgba.green * 255)
    b = round(rgba.blue * 255)
    a = round(rgba.alpha * 255)
    return f"#{r:02x}{g:02x}{b:02x}{a:02x}"

def parse_ratio(ratio_str):
    try:
        ratio_str = ratio_str.strip().replace(',', '.').replace('/', ':')
        if ':' not in ratio_str:
            return None
        w, h = ratio_str.split(':', 1)
        w, h = float(w), float(h)
        if w <= 0 or h <= 0:
            return None
        return w, h
    except Exception:
        return None

def format_size(size_bytes):
    if size_bytes < 1024:
        return f"{size_bytes} B"
    elif size_bytes < 1024 * 1024:
        return f"{size_bytes / 1024:.1f} KB"
    else:
        return f"{size_bytes / (1024 * 1024):.1f} MB"

# --- Okno na orezanie ---
class CropWindow(Adw.Window):
    def __init__(self, parent, image_path, download_folder, ratio_str="3:2"):
        super().__init__()
        self.set_transient_for(parent)
        self.set_modal(True)
        self.set_default_size(1200, 800)
        self.set_title(f"Orezať – {image_path.name}")
        self.image_path = Path(image_path)
        self.download_folder = Path(download_folder)
        self.ratio_label = ratio_str
        self.parent_window = parent

        try:
            self.orig_pixbuf = GdkPixbuf.Pixbuf.new_from_file(str(self.image_path))
            self.orig_pixbuf = self.orig_pixbuf.apply_embedded_orientation()
        except Exception as e:
            print(f"Chyba pri načítaní {image_path}: {e}")
            self.close()
            return

        self.orig_w = self.orig_pixbuf.get_width()
        self.orig_h = self.orig_pixbuf.get_height()

        parsed = parse_ratio(ratio_str)
        if parsed is None:
            print(f"Neplatný pomer '{ratio_str}', používam 3:2")
            target_w, target_h = 3.0, 2.0
            self.ratio_label = "3:2"
        else:
            target_w, target_h = parsed

        target_aspect = target_w / target_h
        self.target_aspect = target_aspect
        img_aspect = self.orig_w / self.orig_h

        if img_aspect > target_aspect:
            self.crop_h = self.orig_h
            self.crop_w = int(round(self.crop_h * target_aspect))
            if self.crop_w > self.orig_w:
                self.crop_w = self.orig_w
                self.crop_h = int(round(self.crop_w / target_aspect))
            self.move_axis = 'x'
        else:
            self.crop_w = self.orig_w
            self.crop_h = int(round(self.crop_w / target_aspect))
            if self.crop_h > self.orig_h:
                self.crop_h = self.orig_h
                self.crop_w = int(round(self.crop_h * target_aspect))
            self.move_axis = 'y'

        self.crop_x = (self.orig_w - self.crop_w) // 2
        self.crop_y = (self.orig_h - self.crop_h) // 2

        self.freehand_mode = False
        self.MIN_CROP = 20
        self.HANDLE_MARGIN = 10

        self.area = Gtk.DrawingArea()
        self.area.set_draw_func(self.on_draw)
        self.area.set_hexpand(True)
        self.area.set_vexpand(True)
        self.set_content(self.area)

        self.drag_start = None
        self.drag_mode = None
        click = Gtk.GestureClick.new()
        click.set_button(1)
        click.connect("pressed", self.on_press)
        click.connect("released", self.on_release)
        self.area.add_controller(click)
        
        right_click = Gtk.GestureClick.new()
        right_click.set_button(3)
        right_click.connect("pressed", lambda *a: self.do_crop())
        self.area.add_controller(right_click)

        motion = Gtk.EventControllerMotion()
        motion.connect("motion", self.on_motion)
        self.area.add_controller(motion)

        key = Gtk.EventControllerKey()
        key.connect("key-pressed", self.on_key)
        self.add_controller(key)

        self.area.connect("resize", lambda *a: self.area.queue_draw())
        self.present()

    def _scale_factor(self):
        aw = self.area.get_width()
        ah = self.area.get_height()
        if aw <= 1 or ah <= 1:
            return 1.0, 0, 0, self.orig_w, self.orig_h
        scale = min(aw / self.orig_w, ah / self.orig_h)
        disp_w = int(self.orig_w * scale)
        disp_h = int(self.orig_h * scale)
        ox = (aw - disp_w) // 2
        oy = (ah - disp_h) // 2
        return scale, ox, oy, disp_w, disp_h

    def on_draw(self, area, cr, width, height):
        scale, ox, oy, dw, dh = self._scale_factor()

        cr.set_source_rgb(0.1, 0.1, 0.1)
        cr.paint()

        cr.save()
        cr.translate(ox, oy)
        cr.scale(scale, scale)
        Gdk.cairo_set_source_pixbuf(cr, self.orig_pixbuf, 0, 0)
        cr.paint()
        cr.restore()

        cr.set_source_rgba(0, 0, 0, 0.55)
        cr.rectangle(0, 0, width, height)
        rx = ox + self.crop_x * scale
        ry = oy + self.crop_y * scale
        rw = self.crop_w * scale
        rh = self.crop_h * scale
        cr.rectangle(rx, ry, rw, rh)
        cr.set_fill_rule(1)
        cr.fill()

        cr.set_source_rgb(1.0, 0.85, 0.1)
        cr.set_line_width(2.5)
        cr.rectangle(rx, ry, rw, rh)
        cr.stroke()

        if self.freehand_mode:
            self._draw_handles(cr, rx, ry, rw, rh)

        cr.set_source_rgb(1, 1, 1)
        cr.select_font_face("Sans", 0, 0)
        cr.set_font_size(14)
        freehand_shortcut = self.parent_window.config.get('Shortcuts', 'crop_freehand_toggle', fallback='f')
        text = f"{self.ratio_label}  |  {self.crop_w}×{self.crop_h}"
        cr.move_to(12, height - 14)
        cr.show_text(text)

    def _draw_handles(self, cr, rx, ry, rw, rh):
        half = 9
        points = [
            (rx, ry), (rx + rw, ry), (rx, ry + rh), (rx + rw, ry + rh),
            (rx + rw / 2, ry), (rx + rw / 2, ry + rh),
            (rx, ry + rh / 2), (rx + rw, ry + rh / 2),
        ]
        for px, py in points:
            cr.set_source_rgba(0, 0, 0, 0.75)
            cr.rectangle(px - half, py - half, half * 2, half * 2)
            cr.fill()
            cr.set_source_rgb(1.0, 0.85, 0.1)
            inner = half - 3
            cr.rectangle(px - inner, py - inner, inner * 2, inner * 2)
            cr.fill()

    def _hit_test(self, sx, sy, rx, ry, rw, rh):
        m = self.HANDLE_MARGIN
        near_left = abs(sx - rx) <= m
        near_right = abs(sx - (rx + rw)) <= m
        near_top = abs(sy - ry) <= m
        near_bottom = abs(sy - (ry + rh)) <= m
        within_x = rx - m <= sx <= rx + rw + m
        within_y = ry - m <= sy <= ry + rh + m

        if near_left and near_top and within_x and within_y:
            return 'corner-TL'
        if near_right and near_top and within_x and within_y:
            return 'corner-TR'
        if near_left and near_bottom and within_x and within_y:
            return 'corner-BL'
        if near_right and near_bottom and within_x and within_y:
            return 'corner-BR'
        if near_left and ry <= sy <= ry + rh:
            return 'edge-left'
        if near_right and ry <= sy <= ry + rh:
            return 'edge-right'
        if near_top and rx <= sx <= rx + rw:
            return 'edge-top'
        if near_bottom and rx <= sx <= rx + rw:
            return 'edge-bottom'
        if rx <= sx <= rx + rw and ry <= sy <= ry + rh:
            return 'move'
        return None

    def _fit_size_to_image(self, w, h, aspect):
        if w > self.orig_w:
            w = self.orig_w
            h = w / aspect
        if h > self.orig_h:
            h = self.orig_h
            w = h * aspect
        return max(self.MIN_CROP, w), max(self.MIN_CROP, h)

    def _clamp_rect_to_image(self, x, y, w, h):
        w = min(w, self.orig_w)
        h = min(h, self.orig_h)
        x = max(0, min(x, self.orig_w - w))
        y = max(0, min(y, self.orig_h - h))
        return x, y, w, h

    def _resize_crop(self, mode, img_x, img_y, start_cx, start_cy, start_cw, start_ch):
        aspect = start_cw / start_ch

        if mode == 'corner-BR':
            ax, ay = start_cx, start_cy
            raw_w, raw_h = img_x - ax, img_y - ay
        elif mode == 'corner-TL':
            ax, ay = start_cx + start_cw, start_cy + start_ch
            raw_w, raw_h = ax - img_x, ay - img_y
        elif mode == 'corner-TR':
            ax, ay = start_cx, start_cy + start_ch
            raw_w, raw_h = img_x - ax, ay - img_y
        elif mode == 'corner-BL':
            ax, ay = start_cx + start_cw, start_cy
            raw_w, raw_h = ax - img_x, img_y - ay
        elif mode == 'edge-right':
            ax = start_cx
            raw_w = img_x - ax
        elif mode == 'edge-left':
            ax = start_cx + start_cw
            raw_w = ax - img_x
        elif mode == 'edge-bottom':
            ay = start_cy
            raw_h = img_y - ay
        elif mode == 'edge-top':
            ay = start_cy + start_ch
            raw_h = ay - img_y
        else:
            return

        if mode.startswith('corner'):
            raw_w = max(raw_w, self.MIN_CROP)
            raw_h = max(raw_h, self.MIN_CROP)
            if raw_w / raw_h > aspect:
                new_h = raw_h
                new_w = new_h * aspect
            else:
                new_w = raw_w
                new_h = new_w / aspect
            new_w, new_h = self._fit_size_to_image(new_w, new_h, aspect)

            if mode == 'corner-BR':
                new_x, new_y = ax, ay
            elif mode == 'corner-TL':
                new_x, new_y = ax - new_w, ay - new_h
            elif mode == 'corner-TR':
                new_x, new_y = ax, ay - new_h
            else:
                new_x, new_y = ax - new_w, ay

            new_x, new_y, new_w, new_h = self._clamp_rect_to_image(new_x, new_y, new_w, new_h)

        elif mode in ('edge-right', 'edge-left'):
            new_h = start_ch
            new_y = start_cy
            if mode == 'edge-right':
                max_w = max(self.MIN_CROP, self.orig_w - ax)
                new_w = min(max(raw_w, self.MIN_CROP), max_w)
                new_x = ax
            else:
                max_w = max(self.MIN_CROP, ax)
                new_w = min(max(raw_w, self.MIN_CROP), max_w)
                new_x = ax - new_w

        else:
            new_w = start_cw
            new_x = start_cx
            if mode == 'edge-bottom':
                max_h = max(self.MIN_CROP, self.orig_h - ay)
                new_h = min(max(raw_h, self.MIN_CROP), max_h)
                new_y = ay
            else:
                max_h = max(self.MIN_CROP, ay)
                new_h = min(max(raw_h, self.MIN_CROP), max_h)
                new_y = ay - new_h

        self.crop_x, self.crop_y = int(round(new_x)), int(round(new_y))
        self.crop_w, self.crop_h = max(1, int(round(new_w))), max(1, int(round(new_h)))

    def on_press(self, gesture, n_press, x, y):
        scale, ox, oy, _, _ = self._scale_factor()

        if self.freehand_mode:
            rx = ox + self.crop_x * scale
            ry = oy + self.crop_y * scale
            rw = self.crop_w * scale
            rh = self.crop_h * scale
            hit = self._hit_test(x, y, rx, ry, rw, rh)
            if hit is None:
                self.drag_mode = None
                self.drag_start = None
                return
            self.drag_mode = hit
            self.drag_start = (x, y, self.crop_x, self.crop_y, self.crop_w, self.crop_h)
            return

        img_x = (x - ox) / scale
        img_y = (y - oy) / scale
        if (self.crop_x <= img_x <= self.crop_x + self.crop_w and
                self.crop_y <= img_y <= self.crop_y + self.crop_h):
            self.drag_mode = 'move'
            self.drag_start = (x, y, self.crop_x, self.crop_y, self.crop_w, self.crop_h)

    def on_release(self, gesture, n_press, x, y):
        self.drag_start = None
        self.drag_mode = None

    def on_motion(self, controller, x, y):
        if self.drag_start is None or self.drag_mode is None:
            return
        scale, ox, oy, _, _ = self._scale_factor()
        start_x, start_y, start_cx, start_cy, start_cw, start_ch = self.drag_start

        if self.drag_mode == 'move':
            dx = (x - start_x) / scale
            dy = (y - start_y) / scale
            if self.freehand_mode:
                new_x = max(0, min(start_cx + dx, self.orig_w - self.crop_w))
                new_y = max(0, min(start_cy + dy, self.orig_h - self.crop_h))
                self.crop_x, self.crop_y = int(round(new_x)), int(round(new_y))
            elif self.move_axis == 'x':
                new_x = int(start_cx + dx)
                self.crop_x = max(0, min(new_x, self.orig_w - self.crop_w))
            else:
                new_y = int(start_cy + dy)
                self.crop_y = max(0, min(new_y, self.orig_h - self.crop_h))
            self.area.queue_draw()
            return

        img_x = (x - ox) / scale
        img_y = (y - oy) / scale
        self._resize_crop(self.drag_mode, img_x, img_y, start_cx, start_cy, start_cw, start_ch)
        self.area.queue_draw()

    def on_key(self, controller, keyval, keycode, state):
        keyval_lower = Gdk.keyval_to_lower(keyval)
        if keyval_lower == Gdk.KEY_Return or keyval_lower == Gdk.KEY_KP_Enter:
            self.do_crop()
            return True
        if keyval_lower == Gdk.KEY_Escape:
            self.close()
            return True

        relevant_mods = (Gdk.ModifierType.CONTROL_MASK |
                          Gdk.ModifierType.ALT_MASK |
                          Gdk.ModifierType.SHIFT_MASK)
        mod = state & relevant_mods
        shortcut_str = self.parent_window.config.get('Shortcuts', 'crop_freehand_toggle', fallback='f')
        want_key, want_mod = parse_shortcut(shortcut_str)
        if want_key and keyval_lower == want_key and mod == want_mod:
            self.freehand_mode = not self.freehand_mode
            self.drag_mode = None
            self.drag_start = None
            self.area.queue_draw()
            return True

        return False

    def do_crop(self):
        try:
            cropped = self.orig_pixbuf.new_subpixbuf(
                self.crop_x, self.crop_y, self.crop_w, self.crop_h
            )
            stem = self.image_path.stem
            suffix = self.image_path.suffix.lower()
            if suffix not in ('.jpg', '.jpeg', '.png', '.webp'):
                suffix = '.jpg'
            dest = self.download_folder / f"{stem}_crop{suffix}"
            counter = 1
            while dest.exists():
                dest = self.download_folder / f"{stem}_crop_{counter}{suffix}"
                counter += 1

            if suffix in ('.jpg', '.jpeg'):
                cropped.savev(str(dest), "jpeg", ["quality"], ["92"])
            elif suffix == '.png':
                cropped.savev(str(dest), "png", [], [])
            elif suffix == '.webp':
                cropped.savev(str(dest), "webp", ["quality"], ["90"])
            else:
                cropped.savev(str(dest), "jpeg", ["quality"], ["92"])

            print(f"Orezané ({self.ratio_label}): {dest}")
            if hasattr(self.parent_window, 'show_toast'):
                self.parent_window.show_toast(f"Orezané: {dest.name}")
            self.close()
        except Exception as e:
            print(f"Chyba pri orezávaní: {e}")

