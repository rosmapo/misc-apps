        self.set_default_size(920, 680)
        self.set_title("Nastavenia – Galéria")
        self.main_window = main_window
        self.config = main_window.config
        self._active_chooser = None
        self._section_pages = {}
        self._list_rows = {}

        toolbar = Adw.ToolbarView()
        self.set_content(toolbar)

        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(title="Nastavenia", subtitle="Galéria"))
        toolbar.add_top_bar(header)

        self.split = Adw.NavigationSplitView()
        self.split.set_min_sidebar_width(200)
        self.split.set_max_sidebar_width(280)
        self.split.set_sidebar_width_fraction(0.28)
        toolbar.set_content(self.split)

        sidebar_page = Adw.NavigationPage()
        sidebar_page.set_title("Kategórie")
        sidebar_page.set_tag("sidebar")

        sidebar_toolbar = Adw.ToolbarView()
        sidebar_header = Adw.HeaderBar()
        sidebar_header.set_show_start_title_buttons(False)
        sidebar_header.set_show_end_title_buttons(False)
        sidebar_header.set_title_widget(Gtk.Label(label="Kategórie"))
        sidebar_toolbar.add_top_bar(sidebar_header)

        self.sidebar_list = Gtk.ListBox()
        self.sidebar_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.sidebar_list.add_css_class("navigation-sidebar")
        self.sidebar_list.connect("row-selected", self._on_sidebar_selected)

        for section in FIELDS.keys():
            title = SECTION_TITLES.get(section, section)
            icon_name = SECTION_ICONS.get(section, "preferences-system-symbolic")

            row = Gtk.ListBoxRow()
            row.section_key = section
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            box.set_margin_start(12)
            box.set_margin_end(12)
            box.set_margin_top(10)
            box.set_margin_bottom(10)

            icon = Gtk.Image.new_from_icon_name(icon_name)
            try:
                icon.set_icon_size(Gtk.IconSize.NORMAL)
            except Exception:
                pass
            box.append(icon)

            label = Gtk.Label(label=title, xalign=0)
            label.set_hexpand(True)
            box.append(label)

            row.set_child(box)
            self.sidebar_list.append(row)
            self._list_rows[section] = row

        sidebar_scrolled = Gtk.ScrolledWindow()
        sidebar_scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sidebar_scrolled.set_child(self.sidebar_list)
        sidebar_toolbar.set_content(sidebar_scrolled)
        sidebar_page.set_child(sidebar_toolbar)
        self.split.set_sidebar(sidebar_page)

        self.content_page = Adw.NavigationPage()
        self.content_page.set_title(" ")
        self.content_page.set_tag("content")

        content_toolbar = Adw.ToolbarView()
        self.content_header = Adw.HeaderBar()
        self.content_header.set_show_start_title_buttons(False)
        self.content_header.set_show_end_title_buttons(False)
        self.content_title = Gtk.Label(label="")
        self.content_header.set_title_widget(self.content_title)
        content_toolbar.add_top_bar(self.content_header)

        self.content_stack = Gtk.Stack()
        self.content_stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.content_stack.set_transition_duration(150)

        for section, fields in FIELDS.items():
            page_widget = self._build_section_page(section, fields)
            self._section_pages[section] = page_widget
            self.content_stack.add_named(page_widget, section)

        content_toolbar.set_content(self.content_stack)
        self.content_page.set_child(content_toolbar)
        self.split.set_content(self.content_page)

        first_section = next(iter(FIELDS.keys()))
        self.sidebar_list.select_row(self._list_rows[first_section])

        key = Gtk.EventControllerKey()
        key.connect("key-pressed", self._on_key)
        self.add_controller(key)

    def _on_key(self, controller, keyval, keycode, state):
        if Gdk.keyval_to_lower(keyval) == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def _on_sidebar_selected(self, listbox, row):
        if row is None:
            return
        section = getattr(row, 'section_key', None) or row.get_name()
        if section not in self._section_pages:
            return
        self.content_stack.set_visible_child_name(section)
        self.content_title.set_label(SECTION_TITLES.get(section, section))
        self.content_page.set_title(SECTION_TITLES.get(section, section))

    def _build_section_page(self, section, fields):
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scrolled.set_vexpand(True)

        clamp = Adw.Clamp()
        clamp.set_maximum_size(700)
        clamp.set_tightening_threshold(500)

        group = Adw.PreferencesGroup()
        group.set_margin_top(12)
        group.set_margin_bottom(24)
        group.set_margin_start(12)
        group.set_margin_end(12)

        for key, field_type, label_text in fields:
            current_value = self.config.get(section, key, fallback='')
            row = self._build_row(section, key, field_type, label_text, current_value)
            group.add(row)

        clamp.set_child(group)
        scrolled.set_child(clamp)
        return scrolled

    def _save_field(self, section, key, value):
        if section not in self.config:
            self.config[section] = {}
        self.config[section][key] = value
        save_config(self.config)
        self.main_window.apply_settings_from_dialog()

    def _build_row(self, section, key, field_type, label_text, current_value):
        if field_type == 'label':
            row = Adw.ActionRow()
            label = Gtk.Label(label=label_text, xalign=0, wrap=True)
            label.set_margin_top(8)
            label.set_margin_bottom(8)
            row.set_child(label)
            return row

        if field_type == 'bool':
            row = Adw.SwitchRow(title=label_text)
            row.set_active(current_value.strip().lower() == 'true')
            row.connect("notify::active", lambda r, p: self._save_field(
                section, key, 'true' if r.get_active() else 'false'))
            return row

        if field_type == 'shortcut':
            row = Adw.ActionRow(title=label_text)
            recorder = ShortcutRecorder(
                current_value,
                on_change=lambda value: self._save_field(section, key, value))
            recorder.set_valign(Gtk.Align.CENTER)
            row.add_suffix(recorder)
            return row

        if field_type.startswith('int'):
            parts = field_type.split(':')
            min_v = int(parts[1]) if len(parts) > 1 else 0
            max_v = int(parts[2]) if len(parts) > 2 else 100000
            row = Adw.SpinRow.new_with_range(min_v, max_v, 1)
            row.set_title(label_text)
            try:
                row.set_value(int(current_value))
            except ValueError:
                row.set_value(min_v)
            row.connect("notify::value", lambda r, p: self._save_field(
                section, key, str(int(r.get_value()))))
            return row

        if field_type == 'color':
            row = Adw.ActionRow(title=label_text)
            rgba = Gdk.RGBA()
            if not rgba.parse(current_value or '#000000'):
                rgba.parse('#000000')
            color_dialog = Gtk.ColorDialog()
            color_dialog.set_with_alpha(True)
            btn = Gtk.ColorDialogButton(dialog=color_dialog, rgba=rgba)
            btn.set_valign(Gtk.Align.CENTER)
            btn.connect("notify::rgba", lambda b, p: self._save_field(
                section, key, rgba_to_hex(b.get_rgba())))
            row.add_suffix(btn)
            return row

        if field_type == 'folder':
            row = Adw.EntryRow(title=label_text)
            row.set_text(current_value)
            row.connect("notify::text", lambda r, p: self._save_field(section, key, r.get_text().strip()))
            btn = Gtk.Button(icon_name="folder-open-symbolic", valign=Gtk.Align.CENTER)
            btn.add_css_class("flat")
            btn.set_tooltip_text("Vybrať priečinok…")
            btn.connect("clicked", lambda b: self._browse_folder(row, section, key))
            row.add_suffix(btn)
            return row

        if field_type.startswith('combo:'):
            options = [o.strip() for o in field_type.split(':', 1)[1].split(',')]
            row = Adw.ComboRow(title=label_text, model=Gtk.StringList.new(options))
            try:
                row.set_selected(options.index(current_value.strip()))
            except ValueError:
                row.set_selected(0)
            row.connect("notify::selected", lambda r, p: self._save_field(
                section, key, options[r.get_selected()]))
            return row

        row = Adw.EntryRow(title=label_text)
        row.set_text(current_value)
        row.connect("notify::text", lambda r, p: self._save_field(section, key, r.get_text().strip()))
        return row

    def _browse_folder(self, row, section, key):
        chooser = Gtk.FileChooserNative.new(
            "Vyber priečinok", self, Gtk.FileChooserAction.SELECT_FOLDER, "Vybrať", "Zrušiť")
        chooser.connect("response", self._on_folder_chosen, row, section, key)
        self._active_chooser = chooser
        chooser.show()

    def _on_folder_chosen(self, chooser, response, row, section, key):
        if response == Gtk.ResponseType.ACCEPT:
            gfile = chooser.get_file()
            if gfile and gfile.get_path():
                row.set_text(gfile.get_path())
                self._save_field(section, key, gfile.get_path())
        self._active_chooser = None

