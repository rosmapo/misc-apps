#!/usr/bin/env python3

import gi
import subprocess

# Importovanie GTK4
gi.require_version('Gtk', '4.0')
from gi.repository import Gtk, GLib

class PowerProfileSwitcher(Gtk.Application):
    """
    GTK4 aplikácia na prepínanie power profilov pomocou powerprofilesctl.
    """
    def __init__(self):
        super().__init__(application_id="com.example.PowerProfileSwitcher")
        self.profiles = ["performance", "balanced", "power-saver"]
        self.radio_buttons = {}
        self.win = None 

    def do_activate(self):
        # Vytvorenie hlavného okna
        self.win = Gtk.ApplicationWindow(application=self, title="Power Profile Switcher (GTK4)")
        self.win.set_default_size(300, 180)
        self.win.set_resizable(False)

        # --- APLIKÁCIA CSS PRE ZAOBLENÉ ROHY ---
        css_provider = Gtk.CssProvider()
        css_data = """
window {
    border-radius: 15px; /* Radius zaoblenia */
    border: 1px solid rgba(0,0,0,0.1); /* Voliteľný jemný okraj */
    background-clip: padding-box;
}
        """
        css_provider.load_from_data(css_data.encode('utf-8'))
        
        Gtk.StyleContext.add_provider_for_display(
            self.win.get_display(),
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        # --- KONIEC APLIKÁCIE CSS ---

        # Vytvorenie vertikálneho boxu pre usporiadanie elementov
        vbox = Gtk.Box.new(Gtk.Orientation.VERTICAL, 10)
        vbox.set_margin_top(20)
        vbox.set_margin_bottom(20)
        vbox.set_margin_start(20)
        vbox.set_margin_end(20)
        self.win.set_child(vbox)

        # --- Rádiové tlačidlá pre profily ---
        current_profile = self._get_current_profile()
        group_button = None # Referencia na lídra skupiny

        for profile in self.profiles:
            label_text = profile.replace('-', ' ').title()
            
            # Vytvorenie CheckButton s textom
            button = Gtk.CheckButton.new_with_label(label_text)
            
            if group_button is None:
                # Prvé tlačidlo: stáva sa lídrom skupiny
                group_button = button
            else:
                # Ostatné tlačidlá: priradia sa k lídrom skupiny
                button.set_group(group_button)

            button.set_halign(Gtk.Align.START)
            self.radio_buttons[profile] = button
            vbox.append(button)

            # Nastavenie aktuálneho stavu (označí sa, ak je aktuálny)
            if profile == current_profile:
                button.set_active(True)

        # Tlačidlo pre aplikovanie zmien
        apply_button = Gtk.Button(label="Nastaviť")
        apply_button.set_css_classes(['suggested-action'])
        apply_button.connect("clicked", self._on_apply_clicked)
        vbox.append(Gtk.Separator.new(Gtk.Orientation.HORIZONTAL))
        vbox.append(apply_button)
        
        self.win.present()

    def _get_current_profile(self):
        """Získa aktuálny aktívny profil."""
        try:
            result = subprocess.run(
                ['powerprofilesctl'],
                check=True,
                capture_output=True,
                text=True
            )
            for line in result.stdout.splitlines():
                if line.strip().startswith('*'):
                    # OPRAVENÉ PARSOVANIE: Získa názov a odstráni koncovú dvojbodku
                    profile_name_raw = line.strip().split()[1]
                    profile_name_clean = profile_name_raw.rstrip(':')
                    return profile_name_clean
            return "Neznámy"
        except Exception:
            return "CHYBA (Daemon/Príkaz nebeží?)"

    def _on_apply_clicked(self, button):
        """Zistí zvolený profil a aplikuje ho."""
        selected_profile = None
        for profile, radio in self.radio_buttons.items():
            if radio.get_active():
                selected_profile = profile
                break

        if selected_profile:
            self._set_profile(selected_profile)
        else:
            self._show_error("Chyba", "Prosím, vyberte jeden z profilov.")

    def _set_profile(self, profile):
        """Zavolá powerprofilesctl pre nastavenie profilu."""
        try:
            subprocess.run(
                ['powerprofilesctl', 'set', profile],
                check=True,
                capture_output=True,
                text=True
            )
            self._show_info("Profil", f"nastavený na: {profile.upper()}")

        except subprocess.CalledProcessError as e:
            self._show_error("Chyba", f"Chyba pri nastavení profilu:\n{e.stderr}")
        except FileNotFoundError:
            self._show_error("Chyba", "Príkaz 'powerprofilesctl' nebol nájdený. Uistite sa, že je nainštalovaný 'power-profiles-daemon'.")

    def _show_info(self, title, message):
        """Zobrazí informačné okno."""
        dialog = Gtk.MessageDialog(
            transient_for=self.win,
            modal=True,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK,
            text=title,
            secondary_text=message
        )
        dialog.connect("response", lambda d, r: d.destroy())
        dialog.present()

    def _show_error(self, title, message):
        """Zobrazí chybové okno."""
        dialog = Gtk.MessageDialog(
            transient_for=self.win,
            modal=True,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.CLOSE,
            text=title,
            secondary_text=message
        )
        dialog.connect("response", lambda d, r: d.destroy())
        dialog.present()

if __name__ == "__main__":
    app = PowerProfileSwitcher()
    exit_status = app.run(None)
    exit(exit_status)
