class PasswordDialog(Adw.Dialog):
    def __init__(self, parent_window, ssid, security, signal="0"):
        super().__init__(title=f"Connect to {ssid}")
        self.set_content_width(420)
        self.parent_window = parent_window
        self.ssid = ssid
        self.signal = signal

        toolbar_view = Adw.ToolbarView()
        self.set_child(toolbar_view)

        header = Adw.HeaderBar()
        header.set_show_end_title_buttons(False)
        header.set_title_widget(Adw.WindowTitle(title=ssid, subtitle=security))
        cancel_btn = Gtk.Button(label="Cancel")
        cancel_btn.connect("clicked", lambda b: self.close())
        header.pack_start(cancel_btn)
        self.connect_btn = Gtk.Button(label="Connect")
        self.connect_btn.add_css_class("suggested-action")
        self.connect_btn.connect("clicked", self._on_connect_clicked)
        header.pack_end(self.connect_btn)
        toolbar_view.add_top_bar(header)

        page = Adw.PreferencesPage()
        self.group = Adw.PreferencesGroup()
        page.add(self.group)

        self.password_row = Adw.PasswordEntryRow(title="Password")
        self.password_row.connect("apply", lambda r: self.connect_btn.emit("clicked"))
        self.password_row.connect("notify::text", self._on_password_changed)
        self.group.add(self.password_row)

        toolbar_view.set_content(page)

    def _on_password_changed(self, row, param):
        pwd = row.get_text()
        if not pwd:
            self.group.set_description("")
        elif len(pwd) < 8:
            self.group.set_description("<span color='#e5484d'>⚠ Weak (min 8 chars)</span>")
        elif len(pwd) < 12:
            self.group.set_description("<span color='#f5b846'>⚡ Medium</span>")
        else:
            self.group.set_description("<span color='#46a758'>✓ Strong</span>")

    def _on_connect_clicked(self, button):
        password = self.password_row.get_text()
        if not password:
            self.parent_window.show_error("Password required for secured networks")
            return
        self.close()
        self.parent_window.connect_to_network(self.ssid, password, signal=self.signal)


class LogViewerDialog(Adw.Dialog):
    def __init__(self, parent_window):
        super().__init__(title="Connection History")
        self.set_content_width(700)
        self.set_content_height(400)

        toolbar_view = Adw.ToolbarView()
        self.set_child(toolbar_view)

        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(title="Connection History"))
        clear_btn = Gtk.Button(label="Clear History")
        clear_btn.add_css_class("destructive-action")
        clear_btn.connect("clicked", self._on_clear_clicked)
        header.pack_start(clear_btn)
        toolbar_view.add_top_bar(header)

        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)

        self.text_view = Gtk.TextView()
        self.text_view.set_editable(False)
        self.text_view.set_monospace(True)
        self.text_view.set_wrap_mode(Gtk.WrapMode.WORD)
        self.text_view.set_margin_start(12)
        self.text_view.set_margin_end(12)
        self.text_view.set_margin_top(12)
        self.text_view.set_margin_bottom(12)

        scroll.set_child(self.text_view)
        toolbar_view.set_content(scroll)

        self.load_history()

    def load_history(self):
        buffer = self.text_view.get_buffer()
        if HISTORY_FILE.exists():
            with open(HISTORY_FILE, "r") as f:
                content = f.read()
                buffer.set_text(content if content else "No connection history yet.")
        else:
            buffer.set_text("No connection history yet.")
        end_iter = buffer.get_end_iter()
        self.text_view.scroll_to_iter(end_iter, 0.0, False, 0.0, 0.0)

    def _on_clear_clicked(self, button):
        if HISTORY_FILE.exists():
            HISTORY_FILE.unlink()
        self.text_view.get_buffer().set_text("History cleared.")


def list_vpn_connections():
    try:
        res = subprocess.run(["nmcli", "-t", "-f", "NAME,TYPE,STATE", "connection", "show"],
                             capture_output=True, text=True, timeout=6)
        vpn_list = []
        for line in res.stdout.splitlines():
            if not line.strip():
                continue
            parts = line.split(":")
            if len(parts) < 3:
                continue
            name, ctype, state = parts[0], parts[1], parts[2]
            if ctype in ("vpn", "wireguard"):
                vpn_list.append((name, state))
        return vpn_list
    except Exception as e:
        log_debug(f"list_vpn_connections error: {e}")
        return []


def toggle_vpn_connection(name, callback=None):
    def _worker():
        try:
            res = subprocess.run(["nmcli", "-t", "-f", "NAME", "connection", "show", "--active"],
                                 capture_output=True, text=True, timeout=6)
            active_names = [l.strip() for l in res.stdout.splitlines() if l.strip()]
            cmd = ["nmcli", "connection", "down" if name in active_names else "up", name]
            log_debug(f"Running VPN toggle: {' '.join(cmd)}")
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
            out = r.stdout.strip() or r.stderr.strip()
            if callback:
                GLib.idle_add(callback, r.returncode == 0, out)
        except Exception as e:
            log_debug(f"toggle_vpn_connection error: {e}")
            if callback:
                GLib.idle_add(callback, False, str(e))
    threading.Thread(target=_worker, daemon=True).start()


