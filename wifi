        ssid_column = Gtk.ColumnViewColumn(title="Network Name", factory=name_factory)
        ssid_column.set_expand(True)
        ssid_column.set_sorter(Gtk.CustomSorter.new(self._sort_by_name))
        view.append_column(ssid_column)

        signal_column = Gtk.ColumnViewColumn(
            title="Signal", factory=self._make_factory(lambda: Gtk.Label(xalign=0), self._bind_signal_label))
        signal_column.set_fixed_width(80)
        signal_column.set_sorter(Gtk.CustomSorter.new(self._sort_by_signal))
        view.append_column(signal_column)

        sec_column = Gtk.ColumnViewColumn(
