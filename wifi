        if not no_scan:
            GLib.idle_add(self.scan_networks)

    def _on_close_request(self, *args):
        self.auto_refresh = False
        return False

    # --- Gtk.ColumnView factories (nahrádzajú staré cell-data-funcs) ---
    def _make_factory(self, widget_ctor, bind_func):
        """Vyrobí Gtk.SignalListItemFactory: 'setup' vytvorí widget (Label/Image)
        a pripojí naň pravé tlačidlo (kontextové menu pre daný riadok),
        'bind' zapamätá aktuálnu položku na widgete a naplní jej obsah."""
        factory = Gtk.SignalListItemFactory()

        def on_setup(f, list_item):
            widget = widget_ctor()
            list_item.set_child(widget)
            gesture = Gtk.GestureClick.new()
            gesture.set_button(3)
            gesture.connect("pressed", self._on_cell_right_click)
            widget.add_controller(gesture)

        def on_bind(f, list_item):
            widget = list_item.get_child()
            item = list_item.get_item()
            widget._row_item = item
            bind_func(widget, item)

        factory.connect("setup", on_setup)
        factory.connect("bind", on_bind)
        return factory

    def _bind_name_label(self, label, item):
        label.set_text(item.display_ssid)
        label.set_ellipsize(Pango.EllipsizeMode.END)

    def _bind_signal_label(self, label, item):
        label.set_text(item.signal_text)

    def _bind_security_label(self, label, item):
        label.set_text(item.security)

    def _bind_type_label(self, label, item):
        label.set_text(item.net_type)

    def _bind_signal_icon(self, image, item):
        if item.net_type == "WiFi":
            if item.signal_value >= 75:
                icon = "network-wireless-signal-excellent-symbolic"
            elif item.signal_value >= 50:
                icon = "network-wireless-signal-good-symbolic"
            elif item.signal_value >= 25:
                icon = "network-wireless-signal-ok-symbolic"
            else:
                icon = "network-wireless-signal-weak-symbolic"
        else:
            icon = "network-wireless-symbolic"
        image.set_from_icon_name(icon)

    def _bind_saved_icon(self, image, item):
        image.set_from_icon_name("emblem-ok-symbolic" if item.is_saved else None)

    def _sort_by_name(self, item_a, item_b, data=None):
        a, b = item_a.display_ssid.lower(), item_b.display_ssid.lower()
        return -1 if a < b else (1 if a > b else 0)

    def _sort_by_signal(self, item_a, item_b, data=None):
        a, b = item_a.signal_value, item_b.signal_value
        return -1 if a < b else (1 if a > b else 0)

    def _position_of(self, item):
        n = self.sort_model.get_n_items()
        for i in range(n):
            if self.sort_model.get_item(i) == item:
                return i
        return None

    def _on_view_activate(self, view, position):
        item = self.sort_model.get_item(position)
        if item is not None:
            self.handle_row_activated(item)

    def _on_cell_right_click(self, gesture, n_press, x, y):
        widget = gesture.get_widget()
        item = getattr(widget, "_row_item", None)
        if item is not None:
            self.show_context_menu(item, widget, x, y)

    def _build_main_menu(self, popover):
        """Znova postaví obsah hamburger menu tesne pred zobrazením -
        vďaka tomu je sekcia VPN vždy aktuálna, rovnako ako predtým
        cez signál 'show' na Gtk.Menu."""
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        box.set_margin_top(6)
        box.set_margin_bottom(6)
        box.set_margin_start(6)
        box.set_margin_end(6)

        def add_item(label, callback, sensitive=True):
            btn = Gtk.Button(label=label)
            btn.set_has_frame(False)
            btn.set_sensitive(sensitive)
            if sensitive:
                btn.connect("clicked", lambda b: (self.menu_popover.popdown(), callback()))
            box.append(btn)
            return btn

        add_item("Connection Info", self.show_connection_info)
        add_item("View History", self.show_history)
        box.append(Gtk.Separator())
        add_item("Connect to Hidden Network", self.connect_hidden_network)
        box.append(Gtk.Separator())
        add_item("Spravovať pripojenia…", lambda: subprocess.Popen(["nm-connection-editor"]))

        vpns = list_vpn_connections()
        box.append(Gtk.Separator())
        vpn_label = Gtk.Label(label="VPN")
        vpn_label.set_xalign(0)
        vpn_label.add_css_class("dim-label")
        vpn_label.add_css_class("caption")
        vpn_label.set_margin_start(6)
        vpn_label.set_margin_top(4)
        box.append(vpn_label)
        if not vpns:
            add_item("(no VPN profiles)", None, sensitive=False)
        else:
            for name, state in vpns:
                label = f"{name} ({state})" if state else f"{name} (inactive)"
                add_item(label, lambda n=name: self.on_vpn_item_activated(n))

        box.append(Gtk.Separator())
        add_item("About", self.show_about)

        popover.set_child(box)

    def on_vpn_item_activated(self, name):
        def callback(success, out):
            msg = out or ("Success" if success else "Failed")
            try:
                n = Notify.Notification.new("connex", f"{name}: {msg}", None)
                n.show()
            except:
                pass
            GLib.timeout_add(800, lambda: None)
        toggle_vpn_connection(name, callback=callback)

    def update_header_status(self):
        code, out, err = self.run_cmd("nmcli -t -f GENERAL.STATE device show")
        connected = False
        for line in out.splitlines():
            if "connected" in line.lower():
                connected = True
                break

        if connected and self.current_ssid:
            self.header_status_icon.set_from_icon_name(
                "network-wireless-signal-excellent-symbolic"
            )
            self.header_status_label.set_markup(f"<b>{self.current_ssid}</b>")
            if self.check_internet():
                self.header_status_label.set_markup(
                    f"<b>{self.current_ssid}</b> <span color='#46a758'>✓</span>"
                )
        else:
            self.header_status_icon.set_from_icon_name(
                "network-wireless-offline-symbolic"
            )
            self.header_status_label.set_text("Disconnected")
        return self.auto_refresh

    def check_internet(self):
        try:
            result = subprocess.run(
                ["ping", "-c", "1", "-W", "2", "1.1.1.1"],
                capture_output=True, timeout=3
            )
            return result.returncode == 0
        except:
            return False

    def auto_scan(self):
        if self.auto_refresh and self.get_visible():
            self.scan_networks(silent=True)
        return self.auto_refresh

    def run_cmd(self, cmd):
        try:
            log_debug(f"Running: {cmd}")
            res = subprocess.run(shlex.split(cmd), capture_output=True, text=True, timeout=8)
            log_debug(f"Result: {res.returncode}, stdout: {res.stdout[:100]}")
            return res.returncode, res.stdout.strip(), res.stderr.strip()
        except subprocess.TimeoutExpired:
            log_debug("Command timed out")
            return 1, "", "Command timed out"
        except Exception as e:
            log_debug(f"Command error: {e}")
            return 1, "", str(e)

    def get_current_connection(self):
        code, out, err = self.run_cmd("nmcli -t -f NAME,TYPE,DEVICE connection show --active")
        for line in out.splitlines():
            parts = line.split(':')
            if len(parts) >= 2 and parts[1] == "802-11-wireless":
                self.current_ssid = parts[0]
                return parts[0]
        self.current_ssid = None
        return None

    def scan_networks(self, silent=False):
        if not silent:
            log_debug("Scanning networks...")
            self.scan_button.set_sensitive(False)

        def scan_thread():
            subprocess.run(["nmcli", "device", "wifi", "rescan"], capture_output=True, timeout=5)
            code, out, err = self.run_cmd("nmcli -t -f SSID,SIGNAL,SECURITY device wifi list")
            saved = get_saved_connections()
            GLib.idle_add(self.update_network_list, code, out, err, silent, saved)

        threading.Thread(target=scan_thread, daemon=True).start()

    def update_network_list(self, code, out, err, silent, saved_networks):
        if not self.get_visible():
            return False

        self.scan_button.set_sensitive(True)
        self.saved_networks = saved_networks

        if code != 0:
            if not silent:
                log_debug(f"Scan failed: {err or 'nmcli error'}")
            return False

        self.current_connection = self.get_current_connection()
        self.store.remove_all()

        seen_ssids = set()
        for line in out.splitlines():
            if not line.strip():
                continue
            parts = line.split(':')
            ssid = parts[0] if parts[0] else "<Hidden Network>"
            if ssid in seen_ssids:
                continue
            seen_ssids.add(ssid)

            signal = parts[1] if len(parts) > 1 else "0"
            sec = parts[2] if len(parts) > 2 else "Open"

            if not sec or sec == "--":
                sec_display = "Open"
            elif "WPA3" in sec:
                sec_display = "WPA3"
            elif "WPA2" in sec:
                sec_display = "WPA2"
            elif "WPA" in sec:
                sec_display = "WPA"
            else:
                sec_display = sec

            display_ssid = f"● {ssid}" if ssid == self.current_connection else ssid
            is_saved = ssid in self.saved_networks
            signal_value = int(signal) if signal.isdigit() else 0

            self.store.append(NetworkItem(
                display_ssid, f"{signal}%", sec_display, signal_value, ssid, "WiFi", is_saved))

        # Zoradenie podľa signálu (zostupne) rieši Gtk.SortListModel cez
        # sorter nastavený na stĺpci - netreba ho tu znova vyvolávať.

        count = self.store.get_n_items()
        if not silent:
            log_debug(f"Found {count} network{'s' if count != 1 else ''}")
        return False

    def on_scan_clicked(self, *_):
        self.scan_networks()

    def connect_hidden_network(self, *_):
        dialog = HiddenNetworkDialog(self)
        dialog.present(self)

    def handle_row_activated(self, item):
        ssid = item.ssid
        security = item.security
        signal = item.signal_value
        is_saved = item.is_saved

        if ssid == "<Hidden Network>":
            self.connect_hidden_network()
            return

        if ssid == self.current_connection:
            self.show_question(
                f"Already connected to {ssid}",
                "Do you want to disconnect?",
                lambda: self.disconnect_network(ssid)
            )
            return

        self.selected_ssid = ssid
        self.selected_security = security

        # Ak je uložený profil, použi ho (heslo je už uložené)
        if is_saved:
            self.connect_with_saved_profile(ssid, signal)
        elif security == "Open":
            self.connect_to_network(ssid, "", signal=signal)
        else:
            dialog = PasswordDialog(self, ssid, security, signal)
            dialog.present(self)

    def connect_with_saved_profile(self, ssid, signal="0"):
        """Pripojí sa pomocou uloženého profilu"""
        log_debug(f"Connecting to {ssid}...")

        def connect_thread():
            try:
                result = subprocess.run(
                    ["nmcli", "connection", "up", ssid],
                    capture_output=True, text=True, timeout=20
                )
                GLib.idle_add(self.on_connect_done, result.returncode,
                            result.stdout, result.stderr, ssid, signal)
            except subprocess.TimeoutExpired:
                GLib.idle_add(self.on_connect_done, 1, "", "Connection timed out", ssid, signal)

        threading.Thread(target=connect_thread, daemon=True).start()

    def connect_to_network(self, ssid, password, hidden=False, signal="0"):
        """Pripojí sa k novej sieti (vytvorí nový profil)"""
        log_debug(f"Connecting to {ssid}...")

        def connect_thread():
            args = ["nmcli", "device", "wifi", "connect", ssid]
            if password:
                args += ["password", password]
            if hidden:
                args += ["hidden", "yes"]

            try:
                result = subprocess.run(args, capture_output=True, text=True, timeout=20)
                GLib.idle_add(self.on_connect_done, result.returncode,
                            result.stdout, result.stderr, ssid, signal)
            except subprocess.TimeoutExpired:
                GLib.idle_add(self.on_connect_done, 1, "", "Connection timed out", ssid, signal)

        threading.Thread(target=connect_thread, daemon=True).start()

    def on_connect_done(self, code, out, err, ssid, signal):
        if code == 0:
            log_debug(f"✓ Connected to {ssid}")
            notification = Notify.Notification.new("Connected", f"Successfully connected to {ssid}", "network-wireless")
            notification.show()
            log_connection(ssid, signal, True)
            GLib.timeout_add(1000, lambda: self.scan_networks(silent=True))
            GLib.timeout_add(1000, self.update_header_status)
        else:
            error_msg = err or out
            if "Secrets were required" in error_msg:
                error_msg = "Incorrect password"
            elif "No network with SSID" in error_msg:
                error_msg = "Network not found"

            log_debug(f"✗ Failed: {error_msg}")
            notification = Notify.Notification.new("Connection Failed", f"Could not connect to {ssid}: {error_msg}", "network-wireless-offline")
            notification.show()
            log_connection(ssid, signal, False, error_msg)
        return False

    def disconnect_network(self, ssid):
        code, out, err = self.run_cmd(f"nmcli connection down '{ssid}'")
        if code == 0:
            log_debug(f"Disconnected from {ssid}")
            notification = Notify.Notification.new("Disconnected", f"Disconnected from {ssid}", "network-wireless-offline")
            notification.show()
            GLib.timeout_add(1000, lambda: self.scan_networks(silent=True))
            GLib.timeout_add(500, self.update_header_status)
        else:
            self.show_error(f"Failed to disconnect: {err}")

    def show_context_menu(self, item, widget, x, y):
        ssid = item.ssid
        is_saved = item.is_saved

        if ssid == "<Hidden Network>":
            return

        pos = self._position_of(item)
        if pos is not None:
            self.selection.set_selected(pos)

        popover = Gtk.Popover()
        popover.set_parent(widget)
        popover.set_pointing_to(Gdk.Rectangle(x=int(x), y=int(y), width=1, height=1))
        popover.connect("closed", lambda p: p.unparent())

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        box.set_margin_top(6)
        box.set_margin_bottom(6)
        box.set_margin_start(6)
        box.set_margin_end(6)

        def add_item(label, callback):
            btn = Gtk.Button(label=label)
            btn.set_has_frame(False)
            btn.connect("clicked", lambda b: (popover.popdown(), callback()))
            box.append(btn)

        add_item("Connect", lambda: self.handle_row_activated(item))

        if ssid == self.current_connection:
            add_item("Disconnect", lambda: self.disconnect_network(ssid))

        if is_saved:
            box.append(Gtk.Separator())
            add_item("Forget Network", lambda: self.forget_network(ssid))

        popover.set_child(box)
        popover.popup()

    def forget_network(self, ssid):
        def _do_forget():
            code, out, err = self.run_cmd(f"nmcli connection delete '{ssid}'")
            if code == 0:
                log_debug(f"Forgot network {ssid}")
                GLib.timeout_add(500, lambda: self.scan_networks(silent=True))
            else:
                log_debug(f"Failed to forget: {err}")

        self.show_question(
            f"Forget network '{ssid}'?",
            "This will remove the saved password and settings.",
            _do_forget
        )

    def show_connection_info(self, *_):
        code, out, err = self.run_cmd("nmcli -t -f GENERAL,IP4 device show")
        if code == 0 and out:
            info_lines = []
            for line in out.splitlines()[:20]:
                if any(x in line for x in ["IP4.ADDRESS", "IP4.GATEWAY", "IP4.DNS", "GENERAL.CONNECTION", "GENERAL.STATE"]):
                    key, val = line.split(":", 1)
                    key = key.replace("GENERAL.", "").replace("IP4.", "")
                    info_lines.append(f"{key}: {val}")
            body = "\n".join(info_lines) if info_lines else "No active connection"
            dialog = Adw.AlertDialog(heading="Network Information", body=body)
            dialog.add_response("ok", "OK")
            dialog.set_default_response("ok")
            dialog.set_close_response("ok")
            dialog.present(self)
        else:
            self.show_error("Could not retrieve connection info")

    def show_history(self, *_):
        dialog = LogViewerDialog(self)
        dialog.present(self)

    def show_about(self, *_):
        dialog = Adw.AboutDialog(
            application_name="connex",
            version="1.1",
            comments="Modern Wi-Fi Manager",
            website="https://github.com/Lluciocc/connex",
            license_type=Gtk.License.MIT_X11,
            developer_name="Lluciocc",
            developers=["Lluciocc"],
        )
        dialog.present(self)

    def show_error(self, message):
        dialog = Adw.AlertDialog(heading="Error", body=message)
        dialog.add_response("ok", "OK")
        dialog.set_default_response("ok")
        dialog.set_close_response("ok")
        dialog.present(self)

    def show_question(self, primary, secondary, on_yes):
        dialog = Adw.AlertDialog(heading=primary, body=secondary)
        dialog.add_response("no", "No")
        dialog.add_response("yes", "Yes")
        dialog.set_response_appearance("yes", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("yes")
        dialog.set_close_response("no")

        def _on_response(d, response):
            if response == "yes":
                on_yes()
        dialog.connect("response", _on_response)
        dialog.present(self)


def run_cmd_sync(cmd):
    try:
        res = subprocess.run(shlex.split(cmd), capture_output=True, text=True, timeout=10)
        return res.returncode, res.stdout.strip(), res.stderr.strip()
    except Exception as e:
        return 1, "", str(e)


def cli_mode(args):
    if args.cli_action == "list":
        code, out, err = run_cmd_sync("nmcli -t -f SSID,SIGNAL,SECURITY device wifi list")
        if code == 0:
            print("SSID\t\tSignal\tSecurity")
            print("-" * 50)
            for line in out.splitlines():
                if line.strip():
                    parts = line.split(':')
                    ssid = parts[0] if parts[0] else "<Hidden>"
                    signal = parts[1] if len(parts) > 1 else "?"
                    sec = parts[2] if len(parts) > 2 else "Open"
                    print(f"{ssid}\t{signal}%\t{sec}")
        return 0
    elif args.cli_action == "connect":
        if not args.ssid:
            print("Error: SSID required")
            return 1
        saved = get_saved_connections()
        if args.ssid in saved:
            result = subprocess.run(["nmcli", "connection", "up", args.ssid],
                                   capture_output=True, text=True, timeout=20)
        else:
            cmd_args = ["nmcli", "device", "wifi", "connect", args.ssid]
            if args.password:
                cmd_args += ["password", args.password]
            result = subprocess.run(cmd_args, capture_output=True, text=True, timeout=20)
        if result.returncode == 0:
            print(f"✓ Connected to {args.ssid}")
            return 0
        else:
            print(f"✗ Failed: {result.stderr}")
            return 1
    elif args.cli_action == "disconnect":
        if not args.ssid:
            print("Error: SSID required")
            return 1
        code, out, err = run_cmd_sync(f"nmcli connection down '{args.ssid}'")
        if code == 0:
            print(f"✓ Disconnected from {args.ssid}")
            return 0
        else:
            print(f"✗ Failed: {err}")
            return 1
    elif args.cli_action == "status":
        code, out, err = run_cmd_sync("nmcli -t -f GENERAL,IP4 device show")
        if code == 0:
            print("Network Status:\n" + "-" * 50)
            for line in out.splitlines()[:15]:
                if any(x in line for x in ["CONNECTION", "STATE", "IP4.ADDRESS", "IP4.GATEWAY"]):
                    print(line.replace(":", ": "))
        return 0
    return 0


class ConnexApp(Adw.Application):
    def __init__(self, no_scan=False):
        super().__init__(application_id="io.github.lluciocc.Connex")
        self.no_scan = no_scan

    def do_activate(self):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        win = self.props.active_window
        if not win:
            win = WifiWindow(self, no_scan=self.no_scan)
        win.present()


def main():
    global DEBUG_MODE
    parser = argparse.ArgumentParser(description="connex - Modern Wi-Fi Manager")
    parser.add_argument("--debug", action="store_true", help="Enable debug mode")
    parser.add_argument("--tray", action="store_true", help="Start in system tray (ignored)")
    parser.add_argument("--cli", dest="cli_action", choices=["list", "connect", "disconnect", "status"], help="CLI mode")
    parser.add_argument("--ssid", help="SSID for CLI connect/disconnect")
    parser.add_argument("--password", help="Password for CLI connect")
    parser.add_argument("--no-scan", action="store_true", help="Disable auto scanning")
    args = parser.parse_args()

    DEBUG_MODE = args.debug
    ensure_config_dir()

    if args.cli_action:
        return cli_mode(args)

    if args.tray:
        print("Warning: --tray mode not supported; launching window instead.", file=sys.stderr)

    app = ConnexApp(no_scan=args.no_scan)
    return app.run(None)


if __name__ == "__main__":
    sys.exit(main())
